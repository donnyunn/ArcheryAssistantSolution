<Window x:Class="UserInterface.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UserInterface"
        mc:Ignorable="d"
        Title="MainWindow" Height="360" Width="1280"
        Background="#FFF8F8FF" Loaded="Window_Loaded">

    <!-- 커스텀 UI 요소를 위한 리소스 정의 -->
    <Window.Resources>
        <!-- 원형 버튼 스타일 -->
        <Style x:Key="CircleButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}" Stroke="Gray" StrokeThickness="1"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="150"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="30"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFD0D0D0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FFA0A0A0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 재생 컨트롤 버튼 스타일 -->
        <Style x:Key="MediaButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="Gray" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="100"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFD0D0D0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FFA0A0A0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 토글 스위치 스타일 -->
        <Style x:Key="ToggleSwitchStyle" TargetType="Border">
            <Setter Property="Background" Value="DarkGray"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="25"/>
        </Style>

        <!-- 토글 스위치 원형 부분 스타일 -->
        <Style x:Key="ToggleSwitchKnobStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="21"/>
            <Setter Property="Height" Value="21"/>
            <Setter Property="Fill" Value="White"/>
        </Style>


        <!-- 커스텀 슬라이더 스타일 -->
        <Style x:Key="LargeThumbSliderStyle" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TickBar x:Name="TopTick" Grid.Row="0" Visibility="Collapsed"
                                     Fill="{TemplateBinding Foreground}" Placement="Top"
                                     Height="4" Margin="0,0,0,2"/>
                            <Border x:Name="TrackBackground" Grid.Row="1" CornerRadius="2" Height="10" 
                                    Margin="25,0" Background="#FFE0E0E0" BorderBrush="#FFC0C0C0" BorderThickness="1">
                                <Canvas Margin="-6,-1">
                                    <Rectangle x:Name="PART_SelectionRange" Height="10" Visibility="Hidden"
                                             Fill="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" 
                                             Stroke="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}" StrokeThickness="1"/>
                                </Canvas>
                            </Border>
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Style>
                                            <Style TargetType="RepeatButton">
                                                <Setter Property="Opacity" Value="0"/>
                                            </Style>
                                        </RepeatButton.Style>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Style>
                                            <Style TargetType="RepeatButton">
                                                <Setter Property="Opacity" Value="0"/>
                                            </Style>
                                        </RepeatButton.Style>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Background="DarkGray" BorderBrush="Gray" BorderThickness="1">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="50" Height="50" Fill="#FF4080FF" Stroke="DarkBlue" StrokeThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                            <TickBar x:Name="BottomTick" Grid.Row="2" Fill="Black"
                                     Placement="Bottom" Height="10" Margin="0,0,0,0"
                                     Visibility="Visible"
                                     TickFrequency="{TemplateBinding TickFrequency}"
                                     Maximum="{TemplateBinding Maximum}"
                                     Minimum="{TemplateBinding Minimum}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 메인 레이아웃 그리드 -->
    <Grid Background="#e6e6e6">
        <StackPanel Orientation="Horizontal">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="10,20,10,10">
                            <TextBlock Text="지연재생" 
                                       Foreground="Black"
                                       FontWeight="Bold"
                                       FontSize="36"
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       FontFamily="맑은 고딕"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="10" x:Name="btnStartPanel">
                            <Grid x:Name="btnStartGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="10,10,5,10">
                                    <Button x:Name="btnRecordStart"
                                            Click="btnRecordStart_Click"
                                            Width="200" Height="200"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid>
                                                    <Image x:Name="ButtonRecordImage" Source="component\Images\ButtonRecord.png" Stretch="Fill"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="5,10,10,10">
                                    <Button x:Name="btnStart"
                                            Click="btnStart_Click"
                                            Width="200" Height="200"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid>
                                                    <Image x:Name="ButtonRecordImage" Source="component\Images\ButtonStart.png" Stretch="Fill"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Button x:Name="btnStop"
                                    Click="btnStop_Click"
                                    Width="410" Height="200"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="Collapsed" Margin="10">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Image Source="component\Images\ButtonStop.png" Stretch="Fill"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Vertical">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="100"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="20, 0, 20, 0"
                                    x:Name="recordTogglePanel" Visibility="Collapsed">
                            <TextBlock Text="녹화" VerticalAlignment="Center" FontSize="12" Margin="10,0,5,0"/>
                            <Grid>
                                <Border x:Name="recordToggleBorder" Style="{StaticResource ToggleSwitchStyle}" MouseUp="recordToggle_Click">
                                    <TextBlock x:Name="recordToggleText" Text="Off  " Foreground="White" 
                                               FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" 
                                               Margin="0,0,5,0"/>
                                </Border>
                                <Ellipse x:Name="recordToggleKnob" Style="{StaticResource ToggleSwitchKnobStyle}" 
                                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" MouseUp="recordToggle_Click"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="10">
                            <Border Background="Black" Width="200" Height="80" BorderBrush="Gray" BorderThickness="1" CornerRadius="15">
                                <TextBlock x:Name="txtDelay" Text="0" Foreground="Yellow" FontWeight="Bold"
                                           FontSize="44" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontFamily="#Bold LED Board-7"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="10,20,10,10">
                            <Slider x:Name="sliderDelay" Width="200" Height="80" Margin="0,10,0,0"
                                    Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="sliderDelay_ValueChanged" 
                                    TickPlacement="BottomRight"
                                    AutoToolTipPlacement="BottomRight" 
                                    AutoToolTipPrecision="0"
                                    Style="{StaticResource LargeThumbSliderStyle}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Vertical">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="10,20,10,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="170"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="돌려보기" 
                                               Foreground="Black"
                                               FontWeight="Bold"
                                               FontSize="36"
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               FontFamily="맑은 고딕"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                                    <TextBlock Text="슬로우모션" 
                                               Foreground="#00B0F0"
                                               FontWeight="Bold"
                                               FontSize="28"
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               FontFamily="맑은 고딕"/>
                                </StackPanel>
                            </Grid>
                            
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,10,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="btnBackward"
                                        Click="btnBackward_Click"
                                        Width="140" Height="140"
                                        Grid.Column="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Image Source="component\Images\ButtonRewind.png" Stretch="Fill"/>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="btnPlay"
                                        Click="btnPlay_Click"
                                        Width="140" Height="140"
                                        Grid.Column="1">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Image x:Name="ButtonPlayImage" Source="component\Images\ButtonPlay.png" Stretch="Fill"/>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="btnForward"
                                        Click="btnForward_Click"
                                        Width="140" Height="140"
                                        Grid.Column="2">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Image Source="component\Images\ButtonFastforward.png" Stretch="Fill"/>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="btnSlow"
                                        Click="btnSlow_Click"
                                        Width="140" Height="140"
                                        Grid.Column="3">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Image x:Name="ButtonSlowImage" Source="component\Images\ButtonSlow.png" Stretch="Fill"/>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="10,0,0,0" HorizontalAlignment="Left">
                            <Border Background="Black" Width="570" Height="80" BorderBrush="Gray" BorderThickness="1" CornerRadius="15">
                                <TextBlock x:Name="statusMessage" Text="PLAY" Foreground="#00FF00" FontWeight="Bold"
                                           FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontFamily="#Bold LED Board-7"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
